# ─── Required ─────────────────────────────────────────────────────────────────
# The process exits immediately if any of these three are missing.

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Postgres connection string. On Railway, reference the Postgres service rather
# than pasting a literal:  ${{ Postgres.DATABASE_URL }}
DATABASE_URL=

# Exactly 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: this key decrypts every user's stored Bayse API keys. It must be
# carried across deployments byte-identical. Changing or regenerating it makes
# all existing bayse_pub_key / bayse_sec_key values permanently undecryptable,
# which silently drops every user out of the active-trading set.
ENCRYPTION_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Injected automatically by Railway. Defaults to 3001 locally.
PORT=

# Override TLS negotiation for Postgres: "require" or "disable".
# Leave unset — it is inferred from the DATABASE_URL host.
PGSSL=

# ─── Not implemented ──────────────────────────────────────────────────────────
# The values below are NOT read anywhere in src/. They are recorded here as
# intent only. Setting them has no effect on the engine's behaviour.
#
# Risk limits currently live as hardcoded constants in the engine. Real
# per-trade sizing is decided in src/engine/executor.js:
#   amount = max(round(max_trade_amount * (0.5 + 0.5 * scale)), 100)
# so the floor is ₦100 and never less than 50% of a user's max_trade_amount.
# There is no daily-loss or balance-percentage enforcement in code.
#
# PLATFORM_FEE_PCT=0.03
# MAX_BALANCE_PCT=0.60
# DAILY_LOSS_LIMIT=0.30
# BTC_MIN_CONFIDENCE=0.72
# MIN_MARKET_PRICE=0.25
# MAX_MARKET_PRICE=0.75
# MM_SPREAD=0.05
# MM_AMOUNT_PER_SIDE=200
